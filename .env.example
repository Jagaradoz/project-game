# mock = in-memory adapter, so every page works before the backend exists.
# live = talk to the real API at NEXT_PUBLIC_API_BASE_URL.
NEXT_PUBLIC_API_MODE=mock

# The backend base URL. Never commit a real one; never put a secret in a
# NEXT_PUBLIC_* variable -- those are inlined into the client bundle.
NEXT_PUBLIC_API_BASE_URL=
